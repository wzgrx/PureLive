+  static String _safeName(String? suggested) {
+    final name = p.posix
+        .basename((suggested ?? '').replaceAll('\\', '/'))
+        .replaceAll(RegExp(r'[<>:"|?*\x00-\x1f]'), '_');
+    return name.isEmpty || name == '.' || name == '..'
+        ? '${const Uuid().v4()}.bin'
+        : name;
   }
 
